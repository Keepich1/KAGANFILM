; Ордо — срез стиля (этап 0 ТЗ). Godot 4.7, Forward+ на ПК, Mobile на телефонах.

config_version=5

[application]

config/name="Ордо — срез стиля"
config/description="Лагерь кыпчаков на закате и столкновение двух отрядов. Этап 0 ТЗ «Ордо»."
run/main_scene="res://scenes/slice.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Ordo="*res://scripts/core/ordo.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.2, 1)

[shader_globals]

ordo_key_tint={
"type": "color",
"value": Color(1, 0.93, 0.84, 1)
}
ordo_shadow_tint={
"type": "color",
"value": Color(0.16, 0.25, 0.42, 1)
}
ordo_terminator={
"type": "color",
"value": Color(0.9, 0.34, 0.18, 0.35)
}
ordo_rim_color={
"type": "color",
"value": Color(1, 0.78, 0.5, 0.9)
}
ordo_band_soft={
"type": "float",
"value": 0.12
}
ordo_brush_amount={
"type": "float",
"value": 0.35
}
ordo_brush_scale={
"type": "float",
"value": 0.9
}
ordo_brush={
"type": "sampler2D",
"value": "res://assets/textures/common/brush_noise.png"
}
ordo_wind={
"type": "vec4",
"value": Vector4(0.8, 0.35, 1, 0.5)
}
