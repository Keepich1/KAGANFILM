class_name HerdDefs
## Стада (ТЗ 5.3, 5.4; docs/ECONOMY.md §3.3–3.5): счёт голов у постройки, не тела ядра.
## Схема — ведущий (M0), значения — ECON. Порядок записей = индекс Defs.
##
## Поля:
##   name; yield {ресурс: за голову в минуту на свежей траве} — выход × трава под стадом;
##   growth_steps [[от голов, голов в минуту], …] — приплод по ступеням (по возрастанию «от»;
##     сверх cap постройки не растёт); growth_period_s — как часто начисляется (кони — раз в 20 с);
##   min_grass — ниже этой травы (0..1000) не растёт; graze — сколько травы (0..1000) вытаптывает стадо
##   в минуту; graze_r — радиус выпаса, м; backing — ресурс, запас которого и есть головы (кони);
##   capturable — можно угнать (барымта, ECONOMY §4.1); head_value {ресурс: за голову} — цена головы
##   при забое, угоне и продаже; flock_max — сколько животных рисует HerdView;
##   model — вид толпы (assets/models/units/<model>.glb); enabled.

const HERDS := {
	# отара 40: 54 еды в минуту на свежей траве (1,35 на голову); +2 головы в минуту летом, пока меньше 40;
	# вытаптывает 6% травы в минуту; одна овца — 12 еды; шерсть (Сб. 2) — 8 в минуту на 40 голов
	"sheep": {"name": "Отара", "yield": {"food": 1.35, "wool": 0.2}, "growth_steps": [[0, 2.0]],
		"growth_period_s": 30, "min_grass": 0, "graze": 60, "graze_r": 22.0, "capturable": true,
		"head_value": {"food": 12}, "flock_max": 12, "model": "sheep"},
	# табун: приплод раз в 20 с по ступеням 0–1: 0, 2–9: +1, 10–19: +2, 20–30: +3; не растёт на траве ниже 30%;
	# вытаптывает 3% травы в минуту
	"horse": {"name": "Табун", "yield": {}, "growth_steps": [[0, 0.0], [2, 3.0], [10, 6.0], [20, 9.0]],
		"growth_period_s": 20, "min_grass": 300, "graze": 30, "graze_r": 26.0, "backing": "horse",
		"capturable": true, "head_value": {"gold": 15}, "flock_max": 20, "model": "horse"},
}
