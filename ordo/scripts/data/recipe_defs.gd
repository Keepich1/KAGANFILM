class_name RecipeDefs
## Мастерские (docs/ECONOMY.md §2.4, §3.5): что из чего делается. Схема — ведущий (M0), значения — ECON.
## Порядок записей = индекс Defs (номер рецепта в SimCmd.set_recipe). Где варится — ключ "recipes" постройки.
##
## Поля: name; in {ресурс: число}, out {ресурс: число} — партия одного работника; time — с на партию;
##   workers — сколько работников мастерская принимает; enabled.

const RECIPES := {
	# Хумдон: 12 ғишт в минуту на работника, 0,5 дерева на кирпич (глина — у воды, не ресурс)
	"brick": {"name": "Ғишт", "in": {"wood": 1}, "out": {"brick": 2}, "time": 10, "workers": 3},
	# Кийизчи үй (Сб. 2): 4 кийиза в минуту на работника за 8 шерсти
	"felt": {"name": "Кийиз", "in": {"wool": 2}, "out": {"felt": 1}, "time": 15, "workers": 3, "enabled": false},
}
